# Shopify Storefront API — create a token in Shopify admin:
# Settings > Apps and sales channels > Develop apps > (your app) > Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional overrides
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_SIGNATURE_COLLECTION=signature-collection
# SHOPIFY_EVERYDAY_COLLECTION=everyday-classics
