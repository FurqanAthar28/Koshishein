# Shopify Storefront API. Everything here is optional: the site reads
# products from the Koshishein store (0ws15g-k8.myshopify.com) without a token.
# SHOPIFY_STORE_DOMAIN=0ws15g-k8.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-07

# Shopify collection handles for the two sections of /collection.
# If neither collection exists, every product is shown in the first section.
# SHOPIFY_SIGNATURE_COLLECTION=signature-collection
# SHOPIFY_EVERYDAY_COLLECTION=everyday-classics
